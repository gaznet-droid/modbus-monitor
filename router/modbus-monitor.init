#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/local/usr/bin/python3 /usr/local/usr/lib/modbus-monitor/monitor.py --config /etc/modbus-monitor.json
    procd_set_param respawn 3600 15 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
