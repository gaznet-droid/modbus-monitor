[Unit]
Description=Check GitHub for a new ModPi commit once a day, early morning

[Timer]
# Backup only. The signed GitHub push webhook (modpi-deploy.path) is the main trigger;
# this catches any push whose webhook delivery was missed.
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
