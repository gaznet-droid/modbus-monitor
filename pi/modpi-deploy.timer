[Unit]
Description=Check GitHub for a new ModPi commit every two minutes

[Timer]
# Polling replaces the GitHub webhook as the main trigger: nothing inbound, no secret.
# A check with no new commit is one small read-only fetch and changes nothing.
OnBootSec=1min
OnUnitInactiveSec=2min
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target
