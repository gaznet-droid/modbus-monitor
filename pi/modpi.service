[Unit]
Description=ModPi read-only meter dashboard
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=modpi
Group=modpi
WorkingDirectory=/opt/modpi
ExecStart=/usr/bin/python3 /opt/modpi/pi/run.py --config /etc/modpi/monitor.json
Restart=always
RestartSec=15
TimeoutStopSec=30
UMask=0077
StateDirectory=modpi
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/modpi
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=48

[Install]
WantedBy=multi-user.target
