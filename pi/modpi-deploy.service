[Unit]
Description=ModPi auto-deploy from GitHub main
Wants=network-online.target
After=network-online.target modpi.service

[Service]
Type=oneshot
# Re-run if another push was queued while this deploy was running.
ExecStart=/bin/sh -c 'while :; do t=$(date +%%s); /bin/sh /usr/local/sbin/modpi-autodeploy || true; r=$(stat -c %%Y /var/lib/modpi/deploy-request 2>/dev/null || echo 0); [ "$r" -ge "$t" ] || break; done'
TimeoutStartSec=1800
Nice=10
