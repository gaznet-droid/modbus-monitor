[Unit]
Description=ModPi TEST collector: Juwai meters read over the LAN (read-only, separate from production)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=modpi
Group=modpi
WorkingDirectory=/opt/modpi
ExecStart=/usr/bin/python3 /opt/modpi/router/juwai_local.py --config /var/lib/modpi/private/juwai-local.json --lock-file /var/lib/modpi/private/juwai-local.lock --run
# A test: it may never slow the production collectors. Switch off with
#   sudo systemctl disable --now modpi-juwai-local
Restart=on-failure
RestartSec=60
Nice=10
MemoryMax=96M
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/modpi
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
TasksMax=16

[Install]
WantedBy=multi-user.target
